# ------------------------------------------------------------------------------
# micro1 Frontier Engineering Challenge 2026 - Environment Configuration
# ------------------------------------------------------------------------------

# Active LLM Provider Key (Groq Cloud Free Tier or Google Gemini)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Asymmetric Model Strategy Architecture:
# ------------------------------------------------------------------------------
# 1. BASELINE: Heavy Monolithic Frontier Model (120B parameters)
BASELINE_MODEL=groq/openai/gpt-oss-120b
# 1. BASELINE: Monolithic Frontier Model (Gemini Flash or Groq Llama 70B)
BASELINE_MODEL=gemini/gemini-flash-latest

# 2. ADVANCED: Fast Agile Model (20B parameters) orchestrated by FSM Squad
ADVANCED_MODEL=groq/openai/gpt-oss-20b
DEFAULT_MODEL=groq/openai/gpt-oss-20b
# 2. ADVANCED: Agile Model (Gemini Flash-Lite or Groq Llama 8B) orchestrated by FSM Squad
ADVANCED_MODEL=gemini/gemini-flash-lite-latest
DEFAULT_MODEL=gemini/gemini-flash-lite-latest
