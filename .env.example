# Live Evaluator LLM Configuration
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=optional_openai_api_key_here

# Model Selection: The Architectural Asymmetry
# 1. BASELINE uses a Heavy/Robust Monolithic Model (Pro)
BASELINE_MODEL=gemini/gemini-pro-latest

# 2. ADVANCED uses a Light/Fast Model orchestrated by FSM (Flash)
ADVANCED_MODEL=gemini/gemini-3.6-flash

# Default fallback if primary exhausted
DEFAULT_MODEL=gemini/gemini-3.6-flash
FALLBACK_MODEL=gemini/gemini-3.6-flash
