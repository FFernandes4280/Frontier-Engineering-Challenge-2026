# ==============================================================================
# Frontier Engineering Challenge 2026 — Configuration
# ==============================================================================

# Primary LLM API Keys (Google Gemini is primary; others optional)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=optional_openai_api_key_here
ANTHROPIC_API_KEY=optional_anthropic_api_key_here

# Asymmetric Model Strategy (Pro for Monolithic Baseline, Flash for FSM Agents)
BASELINE_MODEL=gemini/gemini-3.6-flash
ADVANCED_MODEL=gemini/gemini-3.6-flash
DEFAULT_MODEL=gemini/gemini-3.6-flash
FALLBACK_MODEL=gemini/gemini-3.6-flash

# Model Parameters
LLM_TEMPERATURE=0.2

# Tracing & Observability
TRACE_DIR=./traces
ENABLE_DETAILED_TRACING=true

# Execution & Benchmark Settings
EXECUTION_TIMEOUT_SECONDS=60
