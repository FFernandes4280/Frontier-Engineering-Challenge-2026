# ------------------------------------------------------------------------------
# micro1 Frontier Engineering Challenge 2026 - Environment Configuration Example
# ------------------------------------------------------------------------------

# Option A: Groq Cloud (Free Tier & Ultra-Fast Inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option B: Google Gemini API
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Asymmetric Model Strategy Architecture:
# ------------------------------------------------------------------------------
# 1. BASELINE: Heavy Monolithic Model (120B parameters on Groq, or Pro on Gemini)
BASELINE_MODEL=groq/openai/gpt-oss-120b

# 2. ADVANCED: Fast Agile Model (27B parameters on Groq, or Flash on Gemini)
ADVANCED_MODEL=groq/qwen/qwen3.8-27b
DEFAULT_MODEL=groq/qwen/qwen3.8-27b
